{
  "manifest_version": 2,
  "id": "com.0-hz.maitrpg",
  "version": "0.1.1",
  "name": "麦麦跑团 (MaiTRPG)",
  "description": "让麦麦在群聊里主持并参与一场跑团（TRPG）：内部引擎做规则裁判（骰子/属性/就绪门禁/批处理回合），独立 GM 智能体负责叙事，麦麦作为普通玩家参与。每个聊天流一个会话目录（session.toml + bible/ + characters/ + world_state.md + 追加日志）。",
  "author": {
    "name": "Yufei Pan",
    "url": "https://github.com/yufei-pan"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/yufei-pan/maibot-trpg-plugin",
    "homepage": "https://github.com/yufei-pan/maibot-trpg-plugin",
    "documentation": "https://github.com/yufei-pan/maibot-trpg-plugin/blob/main/README.md",
    "issues": "https://github.com/yufei-pan/maibot-trpg-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomli",
      "version_spec": ">=2.0.0"
    },
    {
      "type": "python_package",
      "name": "tomli-w",
      "version_spec": ">=1.0.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "llm.generate",
    "send.text",
    "send.image",
    "render.html2png",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
